# Copy this file to .env.production and replace every example value.
# Generate secrets with: openssl rand -hex 32
APP_DOMAIN=exposis.example.com
APP_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
POSTGRES_DB=exposis
POSTGRES_USER=exposis
DB_PASSWORD=

# Keep MAIL_MAILER=log until a real SMTP account has been configured.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@exposis.example.com
EXPOSIS_INBOX=contact-lab@exposis.net
